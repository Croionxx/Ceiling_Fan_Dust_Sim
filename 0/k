FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.1;

boundaryField
{
    inlet
    {
        type            kqRWallFunction;
        value           uniform 0.1;
    }

    outlet
    {
        type            kqRWallFunction;
        value           uniform 0.1;
    }

    fan
    {
        type            kqRWallFunction;
        value           uniform 0.1;
    }

    left
    {
        type            kqRWallFunction;
        value           uniform 0.1;
    }

    right
    {
        type            kqRWallFunction;
        value           uniform 0.1;
    }

    front
    {
        type            kqRWallFunction;
        value           uniform 0.1;
    }

    back
    {
        type            kqRWallFunction;
        value           uniform 0.1;
    }
}
