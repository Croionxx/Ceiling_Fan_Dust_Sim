FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 5;

boundaryField
{
    inlet
    {
        type            omegaWallFunction;
        value           uniform 5;
    }

    outlet
    {
        type            omegaWallFunction;
        value           uniform 5;
    }

    fan
    {
        type            omegaWallFunction;
        value           uniform 5;
    }

    left
    {
        type            omegaWallFunction;
        value           uniform 5;
    }

    right
    {
        type            omegaWallFunction;
        value           uniform 5;
    }

    front
    {
        type            omegaWallFunction;
        value           uniform 5;
    }

    back
    {
        type            omegaWallFunction;
        value           uniform 5;
    }
}
