FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    Fan_Centered_m.stl
    {
        type triSurfaceMesh;
        name fan;
    }

    fanCylinder
    {
        type searchableCylinder;
        point1 (0 0 -0.05);
        point2 (0 0  0.05);
        radius 0.60;
    }

    bladeCylinder
    {
        type searchableCylinder;
        point1 (0 0 -0.035);
        point2 (0 0  0.035);
        radius 0.55;
    }

    wakeCylinder
    {
        type searchableCylinder;
        point1 (0 0 -0.80);
        point2 (0 0  0.00);
        radius 0.65;
    }
}

castellatedMeshControls
{
    maxLocalCells           20000000;
    maxGlobalCells          25000000;
    minRefinementCells      10;
    maxLoadUnbalance        0.10;
    nCellsBetweenLevels     3;
    resolveFeatureAngle     25;
    allowFreeStandingZoneFaces true;
    planarAngle             25;

    features
    (
        {
            file  "Fan_Centered_m.eMesh";
            level 5;
        }
    );

    refinementSurfaces
    {
        fan
        {
            level  (5 6);
            patchInfo { type wall; }
        }
    }

    refinementRegions
    {
        bladeCylinder
        {
            mode inside;
            levels  ((1E15 4));
        }

        fanCylinder
        {
            mode inside;
            levels  ((1E15 3));
        }

        wakeCylinder
        {
            mode inside;
            levels  ((1E15 2));
        }
    }

    locationInMesh  (0 0 1.0);
}

snapControls
{
    nSmoothPatch            5;
    tolerance               1.5;
    nSolveIter              50;
    nRelaxIter              8;
    implicitFeatureSnap     false;
    explicitFeatureSnap     true;
    multiRegionFeatureSnap  false;
    nFeatureSnapIter        15;
}

addLayersControls
{
    relativeSizes           true;
    expansionRatio          1.2;
    finalLayerThickness     0.4;
    minThickness            0.05;
    nGrow                   0;
    featureAngle            130;
    slipFeatureAngle        30;
    nRelaxIter              5;
    nSmoothSurfaceNormals   3;
    nSmoothNormals          3;
    nSmoothThickness        10;
    maxFaceThicknessRatio   0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle      90;
    nBufferCellsNoExtrude   0;
    nLayerIter              100;
    nRelaxedIter            20;

    layers
    {
        fan
        {
            nSurfaceLayers  5;
        }
    }
}

meshQualityControls
{
    maxNonOrtho             70;
    maxBoundarySkewness     20;
    maxInternalSkewness     4;
    maxConcave              80;
    minFlatness             0.5;
    minVol                  1e-13;
    minTetQuality           -1e30;
    minArea                 -1;
    minTwist                0.02;
    minDeterminant          0.001;
    minFaceWeight           0.02;
    minVolRatio             0.01;
    minTriangleTwist        -1;
    nSmoothScale            4;
    errorReduction          0.75;

    relaxed
    {
        maxNonOrtho  75;
    }
}

mergeTolerance 1e-6;
